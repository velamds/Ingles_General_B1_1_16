: 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn6le16ob07re2img05.jpg"}, {"text": "<span class=\"strong\">Sally</span>: Hey, V! I think I hear footsteps in the corridor! How much time do you need?<br>\n<span class=\"strong\">Vanessa</span>:The cooker stops in five minutes. I'm getting some appetizers ready in a bit.<br>\n<span class=\"strong\">Sally</span>: I'm going to hold the fort while you battle with that pulled pork. You look determined with that cleaver in your hand. Would you like a drink?<br>\n<span class=\"strong\">Vanessa</span>: I could do with a glass of wine, please.", "id": 1, "time": "100", "image": "engenn6le16ob07re2img05.jpg"}, {"text": "<span class=\"strong\">Sally</span>: Sure. There you go. That should take the edge off. <br>\n<span class=\"strong\">Vanessa</span>: Here they come! Get the door!<br>\n<span class=\"strong\">Sally</span>: I'm going! Don't freak out!<br>\n<span class=\"strong\">Vanessa</span>: You'll handle the guests! I'm going to put the finishing touches on the poutine and the pulled pork.", "id": 2, "time": "19000", "image": "engenn6le16ob07re2img07.jpg"}, {"text": "<span class=\"strong\">Sally</span>: Hey guys! Nice of you to come!<br>\n<span class=\"strong\">Luther</span>: Hi. I'm Luther. Vanessa invited me over.<br>\n<span class=\"strong\">Sally</span>: Oh, you're the saxophonist she told me about. I see you brought your saxophone, too!<br>\n<span class=\"strong\">Luther</span>: Yeah. I always carry it with me. You never know what will happen at a party!<br>\n<span class=\"strong\">Sally</span>: That is true. Can I get you a bottle of beer? A can of soda?<br>\n<span class=\"strong\">Luther</span>: Beer would be great, thank you.", "id": 3, "time": "31000", "image": "engenn6le16ob07re2img01.jpg"}], "audiosrc": "engenn6le16ob07re2aud01", "coverimg": "engenn6le16ob07re2img05.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override"