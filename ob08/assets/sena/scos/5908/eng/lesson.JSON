{"_data": [{"type": "metadata", "contents": [{"content": "Vanessa and Sally Plan a Party", "type": "lesson_name"}, {"content": "A Food Journal", "type": "unit_name"}, {"content": 8, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 16, "type": "lesson"}, {"content": "B1.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Identify and describe personal and regional eating habits and cooking in a range of communicative situations.", "type": "primary"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_1"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_2"}, {"content": "Writes short texts about presenting plans for a future activity at work using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level.", "type": "secondary_3"}, {"content": "Writes short texts about presenting plans for a future activity at work using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level.", "type": "secondary_4"}, {"content": "Writes short texts about presenting plans for a future activity at work using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level.", "type": "secondary_5"}, {"content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_6"}, {"content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_7"}, {"content": " Writes short texts about presenting plans for a future activity at work using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": "Writing a Short Journal Entry", "type": "heading"}, {"content": "A journal is a place where you can express your thoughts and ideas about a subject. You write the date of your journal entry at the beginning of each entry. Keeping a journal is a good way of improving your writing skills and practicing new vocabulary and sentence structure.", "type": "describer"}, {"content": "You could write about general things such as:<br> <ul><li>your family</li> <li>food you have eaten</li> <li>your hobbies and free time activities</li> <li>trips you go on with your family or friends</li> <li>holidays</li> <li>birthdays</li> <li>books you have read</li> <li>films you have seen</li></ul>", "type": "text"}, {"content": "Last night, Sally cooked seafood lasagne.", "type": "example"}, {"content": " She suggested that the roast lamb should sit for twenty minutes.", "type": "example"}, {"content": "For example:<br> <span class=\"italic\">Yesterday, I took my mom to see a movie at the new theater in town. The movie was a comedy and starred Diane Keaton. Afterwards, we went out for dinner. My mom had sushi and I had a salad. It was a great night!", "type": "text"}]}, {"type": "learning_points", "contents": [{"content": "Quantifiers", "type": "heading"}, {"content": "You use a quantifier before a noun to indicate the amount or number of an item.", "type": "describer"}, {"content": "You use quantifiers to talk about the quantity or amount of something.", "type": "text"}, {"content": "Quantifiers can be used with countable and uncountable nouns.   ", "type": "text"}, {"content": "These are quantifiers you can use with countable nouns:<br><ul><li>many</li> <li>several</li> <li>few/a few of</li> <li>a number of</li> <li>a cupful</li> <li>a plateful</li> <li>a sampling</li> <li>a large/great number of</li></ul>", "type": "text"}, {"content": "Can I have a cupful of peanuts? ", "type": "example"}, {"content": "I would love a plateful of pulled pork.", "type": "example"}, {"content": "These are quantifiers you can use with uncountable nouns:<br><ul><li>a bunch</li><li>some</li><li>a little</li></ul>", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "pulled pork ", "type": "name"}, {"content": " meat from a pig that has been slow cooked ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Would you like a pulled-pork sandwich?", "type": "example"}, {"content": "engenn6le16ob08aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use when you are talking about food.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "poutine", "type": "name"}, {"content": "a Canadian dish made with fries, cheese curds and gravy ", "type": "definition"}, {"content": " (noun)", "type": "part_speech"}, {"content": "Example: Can I have some extra gravy on my poutine?", "type": "example"}, {"content": "engenn6le16ob08aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "foodie ", "type": "name"}, {"content": "a person who has a strong interest in food", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": " Example: I'm a bit of a foodie myself.", "type": "example"}, {"content": "engenn6le16ob08aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "sampling ", "type": "name"}, {"content": "a selection", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": " Example: Could I have a sampling from the cheese platter? ", "type": "example"}, {"content": "engenn6le16ob08aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "Caesar salad ", "type": "name"}, {"content": "a salad of romaine lettuce and croutons dressed with parmesan cheese, lemon juice, olive oil, and egg", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Would you add some Caesar salad to my plate?", "type": "example"}, {"content": "engenn6le16ob08aud05", "type": "audio"}]}, {"content": "engenn6le16ob08re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Write a 80 to 100 word journal entry about a meal that someone made.", "type": "text"}, {"content": "Explain what was in the meal and who made it.", "type": "text"}, {"content": "Describe the taste and what the dish looked like.", "type": "text"}, {"content": "Use words to describe quantities and amounts.", "type": "text"}, {"content": "Read the journal entry aloud to a partner.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I write a journal entry about food and cooking.", "type": "text"}, {"content": "I describe a meal using quantities and amounts.", "type": "text"}, {"content": "I describe the taste and what the dish looked like.", "type": "text"}, {"content": "I read my journal entry about food to a partner.", "type": "text"}]}], "labs": [{"exercises": [{"template_override": 1, "_data": [{"type": "instructions", "contents": [{"content": " I can write about food and cooking.", "type": "Learning Outcomes"}, {"content": "  I can talk about quantities and amounts. ", "type": "Learning Outcomes"}, {"content": " I can write a short journal entry.", "type": "Learning Outcomes"}, {"content": " Do you host dinners or parties? Do you invite a lot of people? ", "type": "Free Header Item"}, {"content": " What do you usually cook? What kind of music do you play?", "type": "Free Header Item"}]}, {"type": "group", "contents": [{"cont