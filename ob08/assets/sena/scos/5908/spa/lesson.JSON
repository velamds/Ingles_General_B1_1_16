 in the Self Assessment."}]}]}, {"template_override": 1, "stimuli_ids": [2], "questions": [{"responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 1, "selected": 0}], "id": 0, "_data": [{"contents": [{"type": "text", "content": ""}], "type": "question"}, {"type": "objective", "content": "secondary_3"}]}, {"responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 1, "selected": 0}], "id": 1, "_data": [{"contents": [{"type": "text", "content": "Title of journal entry: "}], "type": "question"}, {"type": "objective", "content": "secondary_3"}]}, {"responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 1, "selected": 0}], "id": 2, "_data": [{"contents": [{"type": "text", "content": "Introductory Sentence:<br> <span class=\"italic\">Example: I had a wonderful meal last Saturday night. </span>"}], "type": "question"}, {"type": "objective", "content": "secondary_3"}]}, {"responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 1, "selected": 0}], "id": 3, "_data": [{"contents": [{"type": "text", "content": "Supporting sentences:<br> <span class=\"italic\">Example: The spiced meat was delicious.</span>"}], "type": "question"}, {"type": "objective", "content": "secondary_3"}]}, {"responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 1, "selected": 0}], "id": 4, "_data": [{"contents": [{"type": "text", "content": " Concluding sentence:<br> <span class=\"italic\">Example:  It was a lovely evening with family and friends and mountains of food.</span>"}], "type": "question"}, {"type": "objective", "content": "secondary_3"}]}], "type": "GWR", "id": 11, "_data": [{"contents": [{"type": "text", "content": "<span class=\"strong\">Imagine you are at a dinner party.  They have made pulled pork and fries.  It looks fantastic.</span><br>\n\n<span class=\"italic\">Instructions:<br>\n<span class=\"bullet\">Watch the video.<br><span class=\"bullet\">Write a 75-100 short journal entry about your meal.<br>\n<span class=\"bullet\">Include who made the meal and where you were.<br>\n<span class=\"bullet\">Describe how the meal looked and tasted. Use adjectives like tasty, juicy, and mouth-watering.<br>\n<span class=\"bullet\">Use quantities and amounts like plateful.<br>\n<span class=\"bullet\">Write in complete sentences and in paragraph form.<br>\n<span class=\"bullet\">When you have typed in ALL your answers, click the <span class=\"strong\">Go to Writing Task</span> button. </span></span>"}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Activity 3"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"contents": [{"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Listening"}], "type": "learning_skills"}, {"contents": [{"type": "text", "content": "<span class=\"strong\">Review your journal.</span><br>"}, {"type": "text", "content": "Remember to include:<br>"}, {"type": "text", "content": "<ul><li>A description of who made the meal and the location</li> \n<li>Adjectives to describe the food </li><li>Quantifiers and amounts like <span class=\"italic\">container</span>, <span class=\"italic\">a lot</span>, and <span class=\"italic\">plateful</span></li><li>An introductory sentence, supporting sentences and a concluding sentence</li></ul>\n\n"}, {"type": "text", "content": "Proofread your journal for spelling, grammar and punctuation errors."}, {"type": "text", "content": "Read your journal entry to a partner.\n"}, {"type": "text", "content": "Click the <span class=\"strong\">Submit</span> button to save your work."}], "type": "instructions"}, {"type": "grading_chart", "grading_contents": {"header": {"rows": [{"cells": [{"element": "th", "colspan": 1, "content_type": "text", "content": ""}, {"element": "th", "colspan": 5, "content_type": "text", "content": ""}]}, {"cells": [{"element": "th", "colspan": 1, "content_type": "text", "content": ""}, {"element": "th", "colspan": 1, "content_type": "text", "content": ""}, {"element": "th", "colspan": 1, "content_type": "text", "content": ""}, {"element": "th", "colspan": 1, "content_type": "text", "content": ""}, {"element": "th", "colspan": 1, "content_type": "text", "content": ""}]}]}, "body": {"rows": [{"cells": [{"element": "th", "colspan": 1, "content_type": "text", "content": ""}, {"content": [" "], "colspan": 1, "content_type": "text", "points": "20", "element": "th"}, {"content": [" "], "colspan": 1, "content_type": "text", "points": "20", "element": "th"}, {"content": [" "], "colspan": 1, "content_type": "text", "points": "20", "element": "th"}, {"content": [" "], "colspan": 1, "content_type": "text", "points": "20", "element": "th"}]}, {"cells": [{"element": "th", "colspan": 1, "content_type": "text", "content": ""}, {"content": [" "], "colspan": 1, "content_type": "text", "points": "20", "element": "th"}, {"content": [" "], "colspan": 1, "content_type": "text", "points": "20", "element": "th"}, {"content": [" "], "colspan": 1, "content_type": "text", "points": "20", "element": "th"}, {"content": [" "], "colspan": 1, "content_type": "text", "points": "20", "element": "th"}]}, {"cells": [{"element": "th", "colspan": 1, "content_type": "text", "content": ""}, {"content": [" "], "colspan": 1, "content_type": "text", "points": "20", "element": "th"}, {"content": [" "], "colspan": 1, "content_type": "text", "points": "20", "element": "th"}, {"content": [" "], "colspan": 1, "content_type": "text", "points": "20", "element": "th"}, {"content": [" "], "colspan": 1, "content_type": "text", "points": "20", "element": "th"}]}, {"cells": [{"element": "th", "colspan": 1, "content_type": "text", "content": ""}, {"content": [" "], "colspan": 1, "content_type": "text", "points": "20", "element": "th"}, {"content": [" "], "colspan": 1, "content_type": "text", "points": "20", "element": "th"}, {"content": [" "], "colspan": 1, "content_type": "text", "points": "20", "element": "th"}, {"content": [" "], "colspan": 1, "content_type": "text", "points": "20", "element": "th"}]}, {"cells": [{"element": "th", "colspan": 1, "content_type": "text", "content": ""}, {"content": [" "], "colspan": 1, "content_type": "text", "points": "20", "element": "th"}, {"content": [" "], "colspan": 1, "content_type": "text", "points": "20", "element": "th"}, {"content": [" "], "colspan": 1, "content_type": "text", "points": "20", "element": "th"}, {"content": [" "], "colspan": 1, "content_type": "text", "points": "20", "element": "th"}]}]}}}]}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn6le16ob08re2img06.jpg", "audiosrc": "engenn6le16ob08re2aud01", "images": [{"time": "0", "image": "engenn6le16ob08re2img06.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn6le16ob08re2img06.jpg", "id": 1, "text": "<span class=\"strong\">Vanessa</span>:  Isn't he amazing! He can play like that for an hour straight.<br>\n<span class=\"strong\">Sally</span>: I love instrumental music. I just wrote a piece on jazz music for Cambridge Life.<br>\n<span class=\"strong\">Luther</span>:  Thanks everyone. Wow, something smells good!<br>\n<span class=\"strong\">Vanessa</span>:  That might be the pulled pork and poutine on the counter. Would you like some?<br>\n<span class=\"strong\">Luther</span>:  Poutine? Isn't that French?"}, {"time": "23000", "image": "engenn6le16ob08re2img01.jpg", "id": 2, "text": "<span class=\"strong\">Sally</span>: Canadian actually, it's a winter favorite.<br>\n<span class=\"strong\">Vanessa</span>:  Here, I'll make up a plate for you while you are putting your sax away. How much would you like?<br>\n<span class=\"strong\">Luther</span>:  I'll have a plateful of the meat and a sampling of the poutine.  Oh and can I have some Caesar salad on the side?"}, {"time": "37500", "image": "engenn6le16ob08re2img02.jpg", "id": 3, "text": "<span class=\"strong\">Vanessa</span>: Sure, no problem. By the way, these recipes are going to be in my cookbook. Right now, I'm collecting recipes in my food journal.<br>\n<span class=\"strong\">Luther</span>: What a great idea! <br>\n<span class=\"strong\">Sally</span>: She is an amazing chef and restaurant manager.<br>\n<span class=\"strong\">Luther</span>: Talented indeed! I'm a bit of a foodie myself. I like to try new restaurants around town.<br>\n<span class=\"strong\">Sally</span>: Well, I'm sure you'll be one of the first to receive Vanessa Cooks, her first edition."}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}, {"contents": [{"type": "video", "value": {"images": [{"time": "0", "image": "", "id": 0, "text": "What is a short journal? <br> <br>A journal is a place where you can express your thoughts and ideas about a subject. <br>\nYou can write about general things. <br>"}], "video_src": "engenn6le16ob08re3vid01"}}], "template_override": 1, "title": "", "type": "video", "id": 2, "_data": []}]}], "_data": [{"contents": [{"type": "lesson_name", "content": "Vanessa and Sally Plan a Party"}, {"type": "unit_name", "content": "A Food Journal"}, {"type": "position", "content": 8}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 16}, {"type": "level", "content": "B1.1"}], "type": "metadata"}, {"contents": [{"type": "test", "content": "false"}], "type": "achievment_test"}, {"contents": [{"type": "primary", "content": "Identify and describe personal and regional eating habits and cooking in a range of communicative situations."}, {"type": "secondary_1", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_2", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_3", "content": "Writes short texts about presenting plans for a future activity at work using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level."}, {"type": "secondary_4", "content": "Writes short texts about presenting plans for a future activity at work using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level."}, {"type": "secondary_5", "content": "Writes short texts about presenting plans for a future activity at work using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level."}, {"type": "secondary_6", "content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_7", "content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_8", "content": " Writes short texts about presenting plans for a future activity at work using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level."}], "type": "objectives"}, {"contents": [{"type": "heading", "content": "Writing a Short Journal"}, {"type": "describer", "content": "A journal is a place where you can express your thoughts and ideas about a subject. You write the date of your journal entry at the beginning of each entry. Keeping a journal is a good way of improving your writing skills and practicing new vocabulary and sentence structure."}, {"type": "text", "content": "You could write about general things such as:<br> <ul><li>your family</li> <li>food you have eaten</li> <li>your hobbies and free time activities</li> <li>trips you go on with your family or friends</li> <li>holidays</li> <li>birthdays</li> <li>books you have read</li> <li>films you have seen</li></ul>"}, {"type": "example", "content": "Last night, Sally cooked seafood lasagne."}, {"type": "example", "content": " She suggested that the roast lamb should sit for twenty minutes."}, {"type": "text", "content": "For example:<br> <span class=\"italic\">Yesterday, I took my mom to see a movie at the new theatre in town. The movie was a comedy and starred Diane Keaton. Afterwards, we went out for dinner. My mom had sushi and I had a salad. It was a great night!"}], "type": "learning_points"}, {"contents": [{"type": "heading", "content": "Quantifiers"}, {"type": "describer", "content": "You use a quantifier before a noun to indicate the amount or number of an item."}, {"type": "text", "content": "You use quantifiers to talk about the quantity or amount of something."}, {"type": "text", "content": "Quantifiers can be used with countable and uncountable nouns.   "}, {"type": "text", "content": "These are quantifiers you can use with countable nouns:<br><ul><li>many</li> <li>several</li> <li>few/a few of</li> <li>a number of</li> <li>a cupful</li> <li>a plateful</li> <li>a sampling</li> <li>a large/great number of</li></ul>"}, {"type": "example", "content": "Can I have a cupful of peanuts? "}, {"type": "example", "content": "I would love a plateful of pulled pork."}, {"type": "text", "content": "These are quantifiers you can use with uncountable nouns:<br><ul><li>a bunch</li><li>some</li><li>a little</li></ul>"}], "type": "learning_points"}, {"contents": [{"type": "name", "content": "pulled pork "}, {"type": "definition", "content": " meat from a pig that has been slow cooked "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Would you like a pulled-pork sandwich?"}, {"type": "audio", "content": "engenn6le16ob08aud01"}], "type": "target_word"}, {"contents": [{"type": "text", "content": " These are words you use when you are talking about food."}], "type": "target_word_describer"}, {"contents": [{"type": "name", "content": "poutine"}, {"type": "definition", "content": "a Canadian dish made with fries, cheese curd and gravy "}, {"type": "part_speech", "content": " (noun)"}, {"type": "example", "content": "Example: Can I have some extra gravy on my poutine?"}, {"type": "audio", "content": "engenn6le16ob08aud02"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "foodie "}, {"type": "definition", "content": "a person who has a strong interest in food"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": " Example: I'm a bit of a foodie myself."}, {"type": "audio", "content": "engenn6le16ob08aud03"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "sampling "}, {"type": "definition", "content": "a selection"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": " Example: Could I have a sampling from the cheese platter? "}, {"type": "audio", "content": "engenn6le16ob08aud04"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "caesar salad "}, {"type": "definition", "content": "a salad of romaine lettuce and croutons dressed with parmesan cheese, lemon juice, olive oil, and egg"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Would you add some caesar salad to my plate?"}, {"type": "audio", "content": "engenn6le16ob08aud05"}], "type": "target_word"}, {"type": "background_image", "content": "engenn6le16ob08re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Write a 80-100 word journal entry about a meal that someone made."}, {"type": "text", "content": "Explain what was in the meal and who made it."}, {"type": "text", "content": "Describe the taste and what the dish looked like."}, {"type": "text", "content": "Use words to describe quantities and amounts."}, {"type": "text", "content": "Read the journal entry aloud to a partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write a journal entry about food and cooking."}, {"type": "text", "content": "I describe a meal using quantities and amounts."}, {"type": "text", "content": "I describe the taste and what the dish looked like."}, {"type": "text", "content": "I read my journal entry about food to a partner."}]}]}